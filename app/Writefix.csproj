<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Writefix</RootNamespace>
    <AssemblyName>Writefix</AssemblyName>
    <Product>Writefix</Product>
    <Description>System-wide spelling and grammar assistant for Windows</Description>
    <ApplicationIcon>writefix.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.22.1" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\Models\encoder.onnx" LogicalName="encoder.onnx" />
    <EmbeddedResource Include="..\Models\decoder.onnx" LogicalName="decoder.onnx" />
    <EmbeddedResource Include="..\Models\tokenizer.json" LogicalName="tokenizer.json" />
    <EmbeddedResource Include="writefix.ico" LogicalName="writefix.ico" />
  </ItemGroup>
  <Target Name="DropNativeLibs" AfterTargets="Publish">
    <ItemGroup>
      <_Lib Include="$(PublishDir)*.lib" />
    </ItemGroup>
    <Delete Files="@(_Lib)" />
  </Target>
</Project>
