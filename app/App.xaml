<Application x:Class="Writefix.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="Ink" Color="#F4F1EA"/>
        <SolidColorBrush x:Key="Mute" Color="#8C877C"/>
        <SolidColorBrush x:Key="Line" Color="#2B2A27"/>
        <SolidColorBrush x:Key="Card" Color="#161513"/>
        <SolidColorBrush x:Key="Brass" Color="#C6A36A"/>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Application.Resources>
</Application>
