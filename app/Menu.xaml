<Window x:Class="Writefix.Menu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Writefix"
        Icon="pack://application:,,,/brand/writefix.png"
        Width="320" Height="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Drag">
    <Border Background="#161513" CornerRadius="16" BorderBrush="#2B2A27" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.55" Color="#000"/>
        </Border.Effect>
        <Grid Margin="18,14,18,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="–" Width="22" Height="22" Click="HideClick" Background="Transparent" Foreground="#8C877C" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="×" Width="22" Height="22" Click="QuitClick" Background="Transparent" Foreground="#8C877C" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/brand/writefix.png" Width="22" Height="22" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="WRITEFIX" FontSize="11" FontWeight="SemiBold" Foreground="#C6A36A" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
            <Grid x:Name="LoadChip" Grid.Row="1" Margin="0,12,0,0" Height="18" SizeChanged="BarSized">
                <Border Background="#2B2A27" CornerRadius="3"/>
                <Border x:Name="LoadFill" HorizontalAlignment="Left" Width="8" Background="#C6A36A" CornerRadius="3"/>
                <TextBlock x:Name="PctText" Text="Loading 0%" Foreground="#161513" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <DockPanel Grid.Row="2" Margin="0,10,0,8">
                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="#C6A36A" Margin="0,0,8,0"/>
                <TextBlock x:Name="StatusText" Text="Loading model" Foreground="#8C877C" FontSize="12" TextWrapping="Wrap"/>
            </DockPanel>
            <StackPanel Grid.Row="3">
                <CheckBox x:Name="OnBox" Content="Enabled everywhere" Checked="Changed" Unchecked="Changed"/>
                <CheckBox x:Name="EndBox" Content="Grammar, close thoughts, punctuate" Checked="Changed" Unchecked="Changed"/>
                <TextBlock Margin="0,10,0,4" Foreground="#8C877C" FontSize="10" Text="TRY IT HERE"/>
                <TextBox x:Name="TestBox" Height="58" Background="#1E1C19" Foreground="#F4F1EA" BorderBrush="#2B2A27"
                         CaretBrush="#C6A36A" TextWrapping="Wrap" AcceptsReturn="False" FontSize="13"
                         Padding="8,6" TextChanged="TestChanged"/>
                <TextBlock x:Name="HintText" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#8C877C" FontSize="11"
                           Text="Typos fix on space. Grammar after a pause. Periods only on a finished thought."/>
            </StackPanel>
            <Button Grid.Row="4" Content="Hide to tray" Click="HideClick" Background="#1E1C19" Foreground="#F4F1EA"
                    BorderBrush="#2B2A27" Height="32" Cursor="Hand"/>
        </Grid>
    </Border>
</Window>
